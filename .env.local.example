# Copy to .env.local and fill in from Supabase: Project Settings > API
# The anon key is safe in a browser bundle — Row Level Security is what protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional. Typing this word anywhere in the terminal opens the admin panel.
# Defaults to "trade" when unset. It is a shortcut, not a lock — the check runs
# in browser code, and what protects the accounts is auth plus row-level security.
VITE_ADMIN_KEYWORD=trade

# Optional, DEV SERVER ONLY. Typing the keyword above into the password box on
# the login screen signs in with these and opens the admin panel, so no email
# needs typing. Sign up once with this email first — the shortcut will not
# create the account for you.
#
# Vite inlines these into the built bundle, so `npm run build` output would
# publish the password to every visitor. The app therefore refuses the shortcut
# unless it is running under `npm run dev`. Never set them on a deployed host.
VITE_ADMIN_EMAIL=you@example.com
VITE_ADMIN_PASSWORD=your-password

# Optional. Allows keyword sign-in outside `npm run dev` — for `npm run preview`
# or a build you host yourself. Switching this on makes the branch reachable, so
# the password above really is readable in the shipped JavaScript, and the login
# screen shows a warning saying so. Only for machines nobody else can reach.
# VITE_ALLOW_KEYWORD_LOGIN=true
